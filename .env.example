# ============================================================
# FasalSetu — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file:
#      - Frontend:
#        Windows (PowerShell): Copy-Item .env.example frontend\.env.local
#        Mac/Linux:            cp .env.example frontend/.env.local
#      - Backend (reads from a .env at the project root):
#        Windows (PowerShell): Copy-Item .env.example .env
#        Mac/Linux:            cp .env.example .env
#   2. Fill in your real values where indicated.
#   3. Never commit .env, .env.local, or any file with real secrets to GitHub.
# ============================================================


# ── FRONTEND (Next.js) ──────────────────────────────────────
# All variables starting with NEXT_PUBLIC_ are exposed to the browser.

# Toggle mock data (set to true for offline/demo development, false to use real backend)
NEXT_PUBLIC_USE_MOCKS=true

# URL of the backend API server
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Mapbox Access Token — required for interactive satellite maps, field drawing,
# and farm location search (Mapbox Geocoding API). A default public token works.
# Get your free public token at: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Google OAuth Client ID for "Sign in with Google" — must be the same value as
# the backend's GOOGLE_CLIENT_ID below. Create one at:
# https://console.cloud.google.com/apis/credentials
# (OAuth client type: "Web application"; add http://localhost:3000 as an
# Authorized JavaScript origin for local development.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ── BACKEND (Python / FastAPI) ───────────────────────────────
# These are server-side only and are never sent to the browser.

# Port the backend server runs on
PORT=8000

# Set to "development", "staging", or "production"
ENVIRONMENT=development

# Internal API base URL (used by backend services calling themselves)
API_BASE_URL=http://localhost:8000/api/v1

# Async SQLAlchemy connection string, e.g. postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fasalsetu

# Origin of the frontend app — used to restrict CORS to this origin only (never *)
FRONTEND_ORIGIN=http://localhost:3000

# External API keys consumed by backend/app/integrations/
WEATHER_API_KEY=
SATELLITE_API_KEY=
AI_API_KEY=

# Gemini (Google GenAI) API keys for the AI Advisor / KrishiBot
# (app/integrations/gemini_client.py). Comma-separated -- a quota or auth
# error on one key falls through to the next. Get a free key at
# https://aistudio.google.com/apikey. Leave blank to run KrishiBot in its
# scripted (non-LLM) fallback mode instead.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order (with every key) when GEMINI_MODEL is overloaded, retired or
# out of quota -- free-tier quota is per model, so these add fresh quota.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ---- Mandi prices (see docs/market-price-api.md) ----
# Agmarknet 2.0 is the primary source and needs no key. Both keys below are
# optional fallbacks, backend-only -- never put them in frontend/.env.
# CEDA Agri Market API key (archive to 2025-10-30, 40 requests/hour):
# https://api.ceda.ashoka.edu.in/documentation/
CEDA_API_KEY=
# data.gov.in API key (latest day only) — free at https://data.gov.in (My Account -> API key).
DATA_GOV_IN_API_KEY=
# Provider fallback order; providers without a key are skipped.
MARKET_PRICE_PROVIDERS=agmarknet,ceda,data_gov_in
# Sell-or-hold suggestion on /market: assumed cost of holding a crop, as % of
# its value per 30 days (storage + weight/quality loss). Rough planning
# figures, not measurements -- tune per region. "Commodity:pct" pairs using
# Agmarknet commodity names; anything unlisted uses the default.
MARKET_HOLDING_COST_PCT=Wheat:1,Rice:1,Paddy(Common):1,Maize:1.5,Soyabean:1.5,Cotton:1,Dry Chillies:2,Potato:3,Onion:4,Green Chilli:15,Tomato:20,Sugarcane:10
MARKET_HOLDING_COST_DEFAULT_PCT=3
# Crops that spoil within days; the UI warns holding may not be possible.
MARKET_PERISHABLE_COMMODITIES=Tomato,Green Chilli,Sugarcane

# Secret used to sign JWT access/refresh tokens — generate a real random value
# per environment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
# and never reuse the default outside local development.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Same Google OAuth Client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID above — used to
# verify the ID token Google hands the frontend. Leave blank to disable
# Google sign-in (POST /auth/google will return an error).
GOOGLE_CLIENT_ID=

# Google Earth Engine — used by backend/app/integrations/earth_engine_client.py
# for satellite crop-health analysis. GEE_PROJECT_ID is always required.
# Leave it blank too to disable EE entirely (the app still starts fine;
# GET /health/earth-engine reports configured: false).
#
# Setup (once): register your Google Cloud project for Earth Engine
# (noncommercial — no billing account needed) at https://earthengine.google.com
#
# Then pick ONE of the two auth methods below:
#
#   A) Local development — Application Default Credentials (recommended;
#      no key file, works even when an org policy blocks service-account
#      key creation). Leave GEE_SERVICE_ACCOUNT_EMAIL/GEE_KEY_PATH blank and
#      instead run once, locally:
#        gcloud auth application-default login --scopes=https://www.googleapis.com/auth/earthengine,https://www.googleapis.com/auth/cloud-platform
#
#   B) Production — a service account. Create one in the GCP project, grant
#      it Earth Engine access, and download its JSON key to
#      secrets/ee-service-account.json (that whole folder is gitignored —
#      NEVER commit the JSON key). Then set both variables below.
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_KEY_PATH=secrets/ee-service-account.json
